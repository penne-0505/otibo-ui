{
  "name": "@otibo/ui",
  "version": "0.2.0",
  "type": "module",
  "description": "otibo Design System UI library (Base UI + Panda CSS)",
  "license": "MIT",
  "author": "penne / ぺんね",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penne-0505/otibo-ui.git"
  },
  "homepage": "https://github.com/penne-0505/otibo-ui#readme",
  "bugs": {
    "url": "https://github.com/penne-0505/otibo-ui/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "panda-css",
    "base-ui",
    "ui-library",
    "otibo"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "panda",
    "panda": "panda",
    "panda:codegen": "panda codegen",
    "panda:watch": "panda --watch",
    "ladle": "ladle serve",
    "ladle:build": "node scripts/verify-ladle-build.mjs",
    "ladle:build:raw": "ladle build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "tsup && panda ship --outfile dist/panda.buildinfo.json",
    "check": "npm run typecheck && npm run lint && npm run build && npm run ladle:build",
    "audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "@pandacss/dev": "^1.11.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@biomejs/biome": "^2.5.3",
    "@ladle/react": "^5.0.3",
    "@pandacss/dev": "^1.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "gen-interface-jp": "^0.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
